# Dockerfile.nethermind — builds state-actor with the cgo_neth tag so
# --client=nethermind works.
#
# RocksDB strategy: build from source. Distro packages
# (debian: 7.8, ubuntu: 8.9) lag the rocksdb release line; grocksdb
# v1.10.x needs RocksDB 10.x. We pin both versions together at the top
# of this file.
#
# Run:
#   docker build -f Dockerfile.nethermind -t state-actor-nethermind:latest .
#   docker run --rm -v $(pwd)/_artifacts/neth:/data state-actor-nethermind:latest \
#     --client=nethermind --db=/data --accounts=0 --contracts=0

# grocksdb's build.sh pins this exact version. If you bump grocksdb in
# go.mod, sync ROCKSDB_VERSION here to whatever its build.sh expects
# (look for `rocksdb_version=` in the grocksdb repo at that tag).
ARG ROCKSDB_VERSION=10.10.1

# ---------- Stage 1: builder (rocksdb + state-actor) ----------
# Both the RocksDB shared library and the state-actor binary are built in
# this stage to avoid header/lib path drift between separate stages. Stage
# 2 (runtime) carries only the .so + state-actor binary, not the toolchain.
FROM golang:1.25-bookworm AS builder

ARG ROCKSDB_VERSION

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    build-essential \
    cmake \
    pkg-config \
    libgflags-dev \
    libsnappy-dev \
    liblz4-dev \
    libzstd-dev \
    libbz2-dev \
    zlib1g-dev \
    gnupg \
    # docker-ce-cli is needed by `make test-nethermind-boot` — the boot
    # test runs inside this builder image and spawns
    # nethermind/nethermind via DinD (host docker socket mount). Without
    # the docker CLI in PATH the test fails at
    # exec.Command("docker", …). Same setup as Dockerfile.reth.
    && install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg \
       | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
    && chmod a+r /etc/apt/keyrings/docker.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] \
       https://download.docker.com/linux/debian bookworm stable" \
       > /etc/apt/sources.list.d/docker.list \
    && apt-get update && apt-get install -y --no-install-recommends docker-ce-cli \
    && rm -rf /var/lib/apt/lists/*

# Build RocksDB from source. -j2 keeps peak memory under ~4GB; rocksdb's
# larger C++ files need 1-2GB per gcc instance and Docker Desktop's
# default 8GB can't sustain $(nproc) parallel compiles on Apple Silicon.
RUN mkdir -p /src && cd /src \
    && curl -fsSL "https://github.com/facebook/rocksdb/archive/refs/tags/v${ROCKSDB_VERSION}.tar.gz" \
       | tar xz \
    && cd rocksdb-${ROCKSDB_VERSION} \
    && PORTABLE=1 USE_RTTI=1 DISABLE_WARNING_AS_ERROR=1 make -j2 shared_lib \
    && make install-shared INSTALL_PATH=/usr/local \
    && ldconfig \
    && cd /src && rm -rf rocksdb-${ROCKSDB_VERSION}
# DISABLE_WARNING_AS_ERROR=1 is needed because gcc 12 (debian bookworm)
# tags a -Wrestrict warning in rocksdb 10.10.1's table/unique_id.cc as
# an error. Building without -Werror is the standard workaround; gcc 13+
# fixes the false positive.

ENV CGO_ENABLED=1 \
    CGO_CFLAGS="-I/usr/local/include" \
    CGO_LDFLAGS="-L/usr/local/lib -lrocksdb -lstdc++ -lm -lz -lbz2 -lsnappy -llz4 -lzstd"

WORKDIR /app

# Cache go.mod / go.sum dependency layer.
COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG STATE_ACTOR_VERSION=dev
RUN go build -tags cgo_neth -ldflags "-s -w -X main.Version=${STATE_ACTOR_VERSION}" -o /out/state-actor .

# ---------- Stage 2: minimal runtime image ----------
FROM debian:bookworm-slim AS runtime

ARG STATE_ACTOR_VERSION=dev
ARG STATE_ACTOR_REVISION=
LABEL org.opencontainers.image.title="State Actor (nethermind)" \
      org.opencontainers.image.description="Ethereum state generator targeting --client=nethermind" \
      org.opencontainers.image.source="https://github.com/ethereum/state-actor" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${STATE_ACTOR_VERSION}" \
      org.opencontainers.image.revision="${STATE_ACTOR_REVISION}"

# Compression libs (rocksdb runtime links against these). RocksDB's own
# .so comes from the builder stage.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libsnappy1v5 \
    liblz4-1 \
    libzstd1 \
    libbz2-1.0 \
    libstdc++6 \
    libgflags2.2 \
    zlib1g \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/lib/librocksdb.so* /usr/local/lib/
RUN ldconfig

COPY --from=builder /out/state-actor /usr/local/bin/state-actor

ENTRYPOINT ["/usr/local/bin/state-actor"]
